{
  "name": "panel-indicator-generator",
  "private": true,
  "license": "WTFPL",
  "type": "module",
  "workspaces": [
    "core",
    "cli",
    "web"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "typecheck": "tsc -p core && tsc -p cli && tsc -p web",
    "schema": "node core/scripts/schema.ts",
    "indicator": "node cli/bin/indicator.ts",
    "web": "npm run dev -w @indicator/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
