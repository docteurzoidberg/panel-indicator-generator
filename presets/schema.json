{
  "title": "Panel indicator preset, v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path or URL of the JSON Schema, for editors",
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "legend": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S",
          "description": "Legend text, on one line"
        },
        "background": {
          "default": "#111111",
          "description": "Color of the legend background (opaque mask) (#rrggbb); black by default",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "window": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": 27,
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Window width (visible part of the legend) (mm)"
        },
        "height": {
          "default": 10.5,
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Window height (mm)"
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": 47,
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Frame width (mm)"
        },
        "height": {
          "default": 18,
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Frame height (mm)"
        },
        "color": {
          "default": "#111111",
          "description": "Frame color (#rrggbb); black by default",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "properties": {
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Thickness of the host panel (= length of the tube) (mm)"
        }
      },
      "required": [
        "thickness"
      ],
      "additionalProperties": false
    },
    "mount": {
      "default": {},
      "type": "object",
      "properties": {
        "head": {
          "default": "countersunk",
          "description": "M3 screws and heat-set inserts; countersunk: countersunk head, socket: socket head (ISO 4762)",
          "type": "string",
          "enum": [
            "countersunk",
            "socket"
          ]
        }
      },
      "additionalProperties": false
    },
    "light": {
      "default": {},
      "type": "object",
      "properties": {
        "wireExit": {
          "default": "left",
          "description": "Exit of the strip wires, seen from the front",
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "legend",
    "panel"
  ],
  "additionalProperties": false,
  "description": "Panel indicator preset (v1). Dimensions in mm."
}
