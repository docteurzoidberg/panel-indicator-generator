#!/bin/sh
# Before every push: French docs following their English version, then typecheck and all
# the tests, the page tests in headless Chromium included (the GitHub action only builds
# and publishes). Refused on uncommitted changes, so that what is tested is what is
# pushed. Enabled by npm install (core.hooksPath); bypass: git push --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes; commit or stash them before pushing." >&2
  exit 1
fi

# A hook does not translate: a commit made here would not leave with this push.
behind=
while read -r _ local _ _; do
  case $local in *[!0]*) ;; *) continue ;; esac   # only zeros: a branch deleted
  behind="$behind$(.githooks/docs-fr-behind "$local" </dev/null)
"
done
behind=$(printf '%s' "$behind" | sed '/^$/d' | sort -u)
if [ -n "$behind" ]; then
  echo "pre-push: English docs ahead of their French version:" >&2
  printf '%s\n' "$behind" | awk '{ print "  " $1 " -> " $2 }' >&2
  echo "Update the French version and commit. Bypass (change without effect on the French text): git push --no-verify" >&2
  exit 1
fi

echo "pre-push: typecheck and tests…"
npm run typecheck --silent && npm test --silent || {
  echo "pre-push: failed, nothing is pushed." >&2
  exit 1
}
